<Window x:Class="ClassroomBooking.SupportRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщить о проблеме" Height="400" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Опишите проблему" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBox x:Name="SubjectTextBox" Grid.Row="1" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBox x:Name="DescriptionTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отправить" Width="120" Height="35" Margin="0,0,10,0" Click="SubmitButton_Click"/>
            <Button Content="Отмена" Width="100" Height="35" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>